# Replace every placeholder; do not commit real secrets.
NODE_ENV=development
PORT=3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api.example/auth/google/callback
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
AUTHORIZED_EMAILS=first@example.com,second@example.com
FRONTEND_ORIGIN=https://your-frontend.example
SESSION_COOKIE_SAME_SITE=lax
